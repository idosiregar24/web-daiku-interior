APP_NAME="Daiku Interior"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=daiku_interior
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Soketi (self-hosted Pusher-protocol server) connection — see docker-compose.yml.
PUSHER_APP_ID=daiku_app_id
PUSHER_APP_KEY=daiku_app_key
PUSHER_APP_SECRET=daiku_app_secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# `log` only writes mails to storage/logs, so the login page hides the
# "Lupa password?" link while MAIL_MAILER is log/array. Production: set
# MAIL_MAILER=smtp and fill in the SMTP account, e.g.
#   MAIL_HOST=smtp.example.com  MAIL_PORT=587 (STARTTLS) or 465 with MAIL_SCHEME=smtps
#   MAIL_USERNAME=no-reply@daikuinterior.com  MAIL_PASSWORD=<app password>
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@daikuinterior.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Mirrors BROADCAST_CONNECTION for the frontend — resources/js/lib/echo.ts
# only opens a WebSocket when this is `pusher`.
VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"

# First accounts for `php artisan db:seed --class=ProductionSeeder` (production
# bootstrap only — see database/seeders/ProductionSeeder.php). Leave empty locally.
INITIAL_CEO_NAME=
INITIAL_CEO_EMAIL=
INITIAL_CEO_PASSWORD=
INITIAL_SUPERADMIN_NAME=
INITIAL_SUPERADMIN_EMAIL=
INITIAL_SUPERADMIN_PASSWORD=

# Daily encrypted DB backup — `php artisan db:backup`, scheduled 00:00 WIB
# (config/backup.php, README "Backup & Restore"). Key: `openssl rand -base64 32`;
# empty = backups stored unencrypted. Keep a copy of the key off the server.
BACKUP_DISK=backups
BACKUP_LOCAL_PATH=
BACKUP_MYSQLDUMP_PATH=mysqldump
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=30

# Production/staging with docker-compose.prod.yml only (README "HTTPS / Produksi").
# APP_DOMAIN = public hostname: nginx server_name, Let's Encrypt cert path and
# the wss:// host baked into the frontend build. Also set there: APP_ENV=production,
# APP_DEBUG=false, APP_URL=https://<APP_DOMAIN>, DB_HOST=mysql, DB_USERNAME (not
# root), REDIS_HOST=redis, CACHE_STORE/QUEUE_CONNECTION=redis, PUSHER_HOST=soketi,
# PUSHER_PORT=6001, PUSHER_SCHEME=http, a random PUSHER_APP_SECRET and
# SESSION_SECURE_COOKIE=true.
APP_DOMAIN=
CERTBOT_EMAIL=
DB_ROOT_PASSWORD=
